# Godot caches (regenerated on import)
.godot/
**/.godot/
*.tmp
# Ableton analysis files (regenerated by Live)
*.asd
# OS noise
Thumbs.db
desktop.ini
.DS_Store
# Windows shortcuts
*.lnk
# Windows builds (build_windows.bat, D395)
dist/
design/shots/
# Process and reference material: kept on disk, out of git (never in an export)
# - the author's request docs and reference media (the transcribed .md in design/requests stays)
*.docx
*.mp4
*.mov
design/ref/
# - Blender and other art sources (the export already excludes art/source/* and *.blend;
#   the gauntlet .blend files are rebuilt by game/tools/blender/gauntlet/gg_<id>.py)
*.blend
*.blend1
game/art/source/
# - the author's untrimmed Chris takes (tools/audio/trim_chris.py makes the shipped loops)
game/audio/source/
# - Black | White's layered music (never played in the tournament: TourneyMusic silences BWMusic's
#   layers; stings are sfx). New music goes in game/audio/music/<set>/ and is tracked.
game/audio/music/layers/*
!game/audio/music/layers/layers.json
game/audio/music/blackwhite_loop.wav*
game/audio/music/drum_beat.wav*

# Python bytecode
__pycache__/
*.pyc
