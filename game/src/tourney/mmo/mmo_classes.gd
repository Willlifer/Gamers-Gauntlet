static func cls(id: String) -> Dictionary:
	return CLASSES[id]


static func abilities(id: String) -> Array:
	return CLASSES[id].abilities


static func ability(cls_id: String, ab_id: String) -> Dictionary:
	for a: Dictionary in CLASSES[cls_id].abilities:
		if str(a.id) == ab_id:
			return a
	for a: Dictionary in CLASSES[cls_id].get("shelf", []):        # an old id still named somewhere
		if str(a.id) == ab_id:
			return a
	return {}


static func color(id: String) -> Color:
	return Color(str(CLASSES[id].col))


static func key_label(slot: int) -> String:
	return ("%d" % (slot + 1)) if slot < 8 else ("s%d" % (slot - 7))
